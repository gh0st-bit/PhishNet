DOMAIN=training.example.com
APP_BASE_URL=https://training.example.com
# Use a URL-safe random value; do not reuse any other secret.
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
WEB_DB_PASSWORD=REPLACE_WITH_INDEPENDENT_32_TO_128_URL_SAFE_CHARACTERS
CONTROL_DB_PASSWORD=REPLACE_WITH_DIFFERENT_32_TO_128_URL_SAFE_CHARACTERS
METRICS_TOKEN=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
SIMULATION_EXTERNAL_DELIVERY_ENABLED=false
SECRET_ROTATION_ENABLED=false
WORKER_DELIVERY_PAUSED=true
SESSION_SECRET=REPLACE_WITH_48_RANDOM_BYTES
MASTER_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
CORS_ORIGINS=https://training.example.com
CAPTURE_RETENTION_DAYS=7
PWNED_PASSWORDS_ENABLED=false
DISPATCH_INTERVAL_MS=400
# Configure transactional delivery separately from tenant campaign SMTP profiles.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PhishNet

# One-time first administrator (create-admin tool). The password is passed separately, never stored here.
ADMIN_EMAIL=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_ORGANIZATION=
